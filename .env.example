# ============================================
# CONFIGURACIÓN DEL BOT DE LIMPIEZA DE CORREO
# ============================================
# Copia este archivo a .env y rellena tus valores
# NUNCA subas el archivo .env real a Git

# --- Autenticación Gmail (elige UNA opción) ---

# Opción A: IMAP + App Password (más simple)
# Requiere: 2FA activado en Google + App Password generado
USE_IMAP=true
EMAIL_USER=tu_correo@gmail.com
EMAIL_APP_PASSWORD=tu_app_password_de_16_caracteres

# Opción B: Gmail API OAuth (más robusto, para producción)
# USE_IMAP=false
# GMAIL_CREDENTIALS_JSON={"installed":{"client_id":"...","client_secret":"...",...}}
# GMAIL_TOKEN_JSON={"token":"...","refresh_token":"...",...}

# --- Configuración de limpieza ---
# Días después de los cuales un correo sin responder aparece en el resumen
DAYS_THRESHOLD=3

# Hora de envío del resumen (formato 24h, zona horaria UTC por defecto)
DIGEST_TIME=08:00
TIMEZONE=UTC

# --- Notificaciones opcionales ---
# Webhook de Telegram para recibir resúmenes ahí también
# Formato: https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>
# TELEGRAM_WEBHOOK=https://api.telegram.org/bot123456:ABC-DEF/sendMessage?chat_id=123456789

# --- Logging ---
LOG_LEVEL=INFO